{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tool Tools API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tools",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of tools",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/tools"
          },
          "docs": "Get a list of tools"
        }
      ]
    }
  ],
  "bundled": true
}