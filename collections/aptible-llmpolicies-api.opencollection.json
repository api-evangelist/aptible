{
  "opencollection": "1.0.0",
  "info": {
    "name": "Aptible API v1 Llm Policies API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "LlmPolicies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "list llm_policies for account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{baseUrl}/accounts/:account_id/llm_policies",
            "headers": [
              {
                "name": "Prefer",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "account_id"
              },
              {
                "name": "no_embed",
                "value": "",
                "type": "query",
                "description": "When true, omits embedded resources from the response. Also triggered when the Prefer: no_sensitive_extras=true header is present."
              }
            ]
          },
          "docs": "Returns a list of LLM policies for the specified account."
        },
        {
          "info": {
            "name": "create or update llm_policy",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{baseUrl}/accounts/:account_id/llm_policies/create_or_update",
            "headers": [
              {
                "name": "Prefer",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "account_id"
              },
              {
                "name": "no_embed",
                "value": "",
                "type": "query",
                "description": "When true, omits embedded resources from the response. Also triggered when the Prefer: no_sensitive_extras=true header is present."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates or updates the LLM policy for the specified account."
        },
        {
          "info": {
            "name": "list all llm_policies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{baseUrl}/llm_policies",
            "headers": [
              {
                "name": "Prefer",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Current page of paginated results"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page"
              },
              {
                "name": "no_embed",
                "value": "",
                "type": "query",
                "description": "When true, omits embedded resources from the response. Also triggered when the Prefer: no_sensitive_extras=true header is present."
              }
            ]
          },
          "docs": "Returns a paginated list of all LLM policies."
        },
        {
          "info": {
            "name": "show llm_policy",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{baseUrl}/llm_policies/:id",
            "headers": [
              {
                "name": "Prefer",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "LLM Policy database ID"
              },
              {
                "name": "no_embed",
                "value": "",
                "type": "query",
                "description": "When true, omits embedded resources from the response. Also triggered when the Prefer: no_sensitive_extras=true header is present."
              }
            ]
          },
          "docs": "Returns the details of a specific LLM policy by ID."
        },
        {
          "info": {
            "name": "get llm policy usage",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{baseUrl}/llm_policies/:id/usage",
            "headers": [
              {
                "name": "Prefer",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "LLM Policy database ID"
              },
              {
                "name": "start_date",
                "value": "",
                "type": "query",
                "description": "Start date for the usage period (YYYY-MM-DD)"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query",
                "description": "End date for the usage period (YYYY-MM-DD, exclusive)"
              },
              {
                "name": "no_embed",
                "value": "",
                "type": "query",
                "description": "When true, omits embedded resources from the response. Also triggered when the Prefer: no_sensitive_extras=true header is present."
              }
            ]
          },
          "docs": "Returns aggregated usage statistics for the specified LLM policy over a date range."
        }
      ]
    }
  ],
  "bundled": true
}