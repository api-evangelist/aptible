{
  "opencollection": "1.0.0",
  "info": {
    "name": "Aptible API v1 Root API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Root",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "show home",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{baseUrl}/",
            "headers": [
              {
                "name": "Prefer",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "no_embed",
                "value": "",
                "type": "query",
                "description": "When true, omits embedded resources from the response. Also triggered when the Prefer: no_sensitive_extras=true header is present."
              }
            ]
          },
          "docs": "Returns the root resource with links to top-level collections."
        }
      ]
    }
  ],
  "bundled": true
}