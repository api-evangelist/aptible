{
  "opencollection": "1.0.0",
  "info": {
    "name": "Aptible API v1 Containers API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Containers",
        "type": "folder"
      },
      "items": [
