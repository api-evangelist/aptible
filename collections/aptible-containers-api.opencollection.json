                "name": "no_embed",
                "value": "",
                "type": "query",
                "description": "When true, omits embedded resources from the response. Also triggered when the Prefer: no_sensitive_extras=true header is present."
              }
            ]
          },
          "docs": "Returns the details of a specific container by ID."
        },
        {
          "info": {
            "name": "list containers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{baseUrl}/log_drains/:log_drain_id/containers",
            "headers": [
