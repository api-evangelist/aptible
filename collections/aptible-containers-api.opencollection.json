          "info": {
            "name": "list containers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{baseUrl}/releases/:release_id/containers",
            "headers": [
              {
                "name": "Prefer",
                "value": ""
              }
            ],
            "params": [
