                "name": "release_id",
                "value": "",
                "type": "path",
                "description": "release_id"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Current page of paginated results"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page"
              },
              {
                "name": "no_embed",
                "value": "",
                "type": "query",
                "description": "When true, omits embedded resources from the response. Also triggered when the Prefer: no_sensitive_extras=true header is present."
              }
            ]
          },
          "docs": "Returns a paginated list of containers for the specified release."
        },
        {
          "info": {
            "name": "show container",
            "type": "http"
          },
