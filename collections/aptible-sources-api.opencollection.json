{
  "opencollection": "1.0.0",
  "info": {
    "name": "Aptible API v1 Sources API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sources",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "list sources",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{baseUrl}/sources",
            "headers": [
              {
                "name": "Prefer",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Current page of paginated results"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page"
              },
              {
                "name": "no_embed",
                "value": "",
                "type": "query",
                "description": "When true, omits embedded resources from the response. Also triggered when the Prefer: no_sensitive_extras=true header is present."
              }
            ]
          },
          "docs": "Returns a paginated list of all sources accessible to the current user."
        },
        {
          "info": {
            "name": "show source",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{baseUrl}/sources/:id",
            "headers": [
              {
                "name": "Prefer",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "id"
              },
              {
                "name": "no_embed",
                "value": "",
                "type": "query",
                "description": "When true, omits embedded resources from the response. Also triggered when the Prefer: no_sensitive_extras=true header is present."
              }
            ]
          },
          "docs": "Returns the details of a specific source by ID."
        },
        {
          "info": {
            "name": "list apps",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{baseUrl}/sources/:source_id/apps",
            "headers": [
              {
                "name": "Prefer",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "source_id",
                "value": "",
                "type": "path",
                "description": "source_id"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Current page of paginated results"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page"
              },
              {
                "name": "no_embed",
                "value": "",
                "type": "query",
                "description": "When true, omits embedded resources from the response. Also triggered when the Prefer: no_sensitive_extras=true header is present."
              }
            ]
          },
          "docs": "Returns a paginated list of apps associated with the specified source."
        },
        {
          "info": {
            "name": "list deployments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{baseUrl}/sources/:source_id/deployments",
            "headers": [
              {
                "name": "Prefer",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "source_id",
                "value": "",
                "type": "path",
                "description": "source_id"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Current page of paginated results"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page"
              },
              {
                "name": "no_embed",
                "value": "",
                "type": "query",
                "description": "When true, omits embedded resources from the response. Also triggered when the Prefer: no_sensitive_extras=true header is present."
              }
            ]
          },
          "docs": "Returns a paginated list of deployments associated with the specified source."
        }
      ]
    }
  ],
  "bundled": true
}