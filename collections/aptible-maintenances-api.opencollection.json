{
  "opencollection": "1.0.0",
  "info": {
    "name": "Aptible API v1 Maintenances API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Maintenances",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "list apps with maintenance info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{baseUrl}/maintenances/apps",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Current page of paginated results"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page"
              }
            ]
          },
          "docs": "Returns a paginated list of apps with their maintenance deadline info."
        },
        {
          "info": {
            "name": "list databases with maintenance info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{baseUrl}/maintenances/databases",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Current page of paginated results"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page"
              }
            ]
          },
          "docs": "Returns a paginated list of databases with their maintenance deadline info."
        }
      ]
    }
  ],
  "bundled": true
}